# Environment Variables — Babel Server
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed.

# ── Server ────────────────────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large-v3 | large-v3-turbo
BABEL_MODEL_SIZE=large-v3-turbo

# Compute device: cuda | cpu
BABEL_DEVICE=cuda

# Precision: float16 (GPU) | int8 (CPU)
BABEL_COMPUTE_TYPE=float16

# Port the FastAPI server listens on
BABEL_PORT=8000

# Allowed CORS origins (comma-separated). Use * only for local development.
BABEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
